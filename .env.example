# Copy to .env and fill in. .env is ignored by git; never commit real values.

# Local ports for docker compose
API_PORT=8000
DASHBOARD_PORT=8501

# Only needed when the dashboard runs outside docker compose and should use a running API.
# Leave empty to score locally.
API_URL=

# AWS deployment (see section 7 of docs/user_guide.md)
AWS_REGION=eu-west-2
AWS_ACCOUNT_ID=123456789012
ECR_API_REPOSITORY=purchase-intent-api
ECR_DASHBOARD_REPOSITORY=purchase-intent-dashboard
IMAGE_TAG=latest
